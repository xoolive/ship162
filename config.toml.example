# Ship162 Configuration File Example
#
# This file demonstrates all available configuration options for ship162.
# Copy this file to one of the following locations:
#   - $SHIP162_CONFIG (environment variable pointing to config file)
#   - $XDG_CONFIG_HOME/ship162/config.toml
#   - ~/.config/ship162/config.toml

# Output file for received AIS messages in JSON format
# output = "/tmp/ais_messages.jsonl"

# Logging configuration
# log_file = "/tmp/ship162.log"  # Use "-" for stdout (only in non-interactive mode)

# Prevent computer from sleeping while decoding
prevent_sleep = false

# Redis configuration for message publishing
# redis_url = "redis://localhost:6379"
# redis_topic = "ship162"

# Multiple sources can be defined. Each [[sources]] section defines one source.
# All SDR sources share the same top-level fields for gain, sample_rate, and bias_tee.

# --- RTL-SDR Examples ---

# Example 1: RTL-SDR with device index
[[sources]]
rtlsdr = { device = 0 }
gain = 49.6        # Recommended gain for AIS reception (default: 49.6)
bias_tee = false   # Enable to power external LNA (default: false)

# Example 2: RTL-SDR with custom sample rate at source level
# [[sources]]
# rtlsdr = { device = 0 }
# sample_rate = 1536000   # 1.536 MS/s (default: 288000)
# gain = 49.6

# Example 3: RTL-SDR selected by serial number
# [[sources]]
# rtlsdr = { serial = "00000001" }
# gain = 49.6
# bias_tee = true   # Enable bias-tee for external LNA

# Example 4: RTL-SDR with manufacturer/product filters
# [[sources]]
# rtlsdr = { manufacturer = "Realtek", product = "RTL2838", serial = "00000001" }
# gain = 49.6

# --- Airspy Examples ---

# Example 5: Airspy default device at 6 MS/s
# [[sources]]
# airspy = { device = 0 }
# gain = "auto"
# bias_tee = false

# Example 6: Airspy with explicit sample rate
# [[sources]]
# airspy = { device = 0 }
# sample_rate = 6000000   # 6 MS/s (default for Airspy)
# gain = "auto"

# Example 7: Airspy selected by serial number
# [[sources]]
# airspy = { serial = "0x35AC63DC2D8C7A4F" }
# gain = "auto"
# bias_tee = false

# --- HackRF Examples ---

# Example 8: HackRF default device
# [[sources]]
# hackrf = { device = 0 }
# gain = "auto"

# Example 9: HackRF with RF amplifier enabled
# [[sources]]
# hackrf = { device = 0, amp_enable = true }
# gain = "auto"
# bias_tee = false

# --- SoapySDR Examples ---

# Example 10: SoapySDR with RTL-SDR driver
# [[sources]]
# soapy = "driver=rtlsdr"
# gain = 49.6
# bias_tee = false

# Example 11: Airspy Mini at 3 MS/s via SoapySDR
# [[sources]]
# soapy = "driver=airspy"
# sample_rate = 3000000   # 3 MS/s (automatically upsampled for demodulation)
# gain = 49.6

# --- IQ File Source ---

# Example 12: IQ file replay (cu8 format, sample_rate defaults to 288 kHz)
# [[sources]]
# iqfile = "/path/to/recording.iq"

# --- TCP Source ---

# Example 13: TCP source (Norwegian AIS server)
[[sources]]
tcp = "153.44.253.27:5631"

# Example 14: TCP source with SSH tunnel (requires ssh feature)
# [[sources]]
# tcp = { host = "remote-ais-server.example.com", port = 5631, jump = "jumphost" }

# or more simply
# tcp.host = "153.44.253.27"
# tcp.port = 5631
# tcp.jump = "jumphost"

# --- WebSocket Source --

# Example 15: WebSocket source
# [[sources]]
# ws = "ws://remote_host:88888"

# Example 16: WebSocket source with SSH tunnel (requires ssh feature)
# [[sources]]
# ws = { url = "ws://remote_host:88888", jump = "jumphost" }

# --- MQTT Source ---

# Example 17: MQTT source (Finnish Digitraffic broker)
[[sources]]
mqtt = "mqtt://mqtt.digitraffic.fi"


# ========== GAIN ==========
#
# All SDR sources share the top-level `gain` field:
#
#   # omitted          # Use ship162's per-device AIS default
#   gain = 49.6        # Manual gain in dB
#   gain = "auto"      # Explicit automatic gain control where supported
#
# Recommended defaults per device:
#   RTL-SDR:  49.6 dB (maximum, best for AIS at 162 MHz)
#   SoapySDR: 49.6 dB
#   Airspy:   "auto" (recommended; device uses sensitivity gain table)
#   HackRF:   "auto" (device applies sensible LNA/VGA defaults)

# ========== SAMPLE RATE ==========
#
# `sample_rate` is a top-level source field, not inside the device config:
#
#   [[sources]]
#   rtlsdr = { device = 0 }
#   sample_rate = 1536000     # 1.536 MS/s
#
# Default: 288000 Hz (288 kHz) for RTL-SDR and HackRF; 6000000 Hz (6 MS/s) for Airspy.
#
# Supported rates (automatically decimated to 96 kHz for AIS decoding):
# - 96000 Hz      (96 kHz, direct passthrough)
# - 192000 Hz     (192 kHz, ÷2)
# - 288000 Hz     (288 kHz, ÷3, default)
# - 384000 Hz     (384 kHz, ÷4)
# - 576000 Hz     (576 kHz, ÷6)
# - 768000 Hz     (768 kHz, ÷8)
# - 1152000 Hz    (1.152 MS/s, ÷12)
# - 1536000 Hz    (1.536 MS/s, ÷16)
# - 2304000 Hz    (2.304 MS/s, ÷24)
# - 3072000 Hz    (3.072 MS/s, ÷32)
# - 6144000 Hz    (6.144 MS/s, ÷64)
# - 12288000 Hz   (12.288 MS/s, ÷128)
#
# Non-standard rates are automatically upsampled to the nearest supported rate:
#   3000000 → 3072000 (Airspy Mini)
#   6000000 → 6144000 (Airspy Mini / R2)

# ========== BIAS-TEE ==========
#
# Powers external LNAs through the antenna cable.
# Supported on RTL-SDR, SoapySDR, Airspy, and HackRF.
#
# WARNING: Only enable if your LNA requires it — wrong use can damage hardware.
#
#   bias_tee = true    # Enable 5 V on antenna port
#   bias_tee = false   # Default

# ========== SSH TUNNELING ==========
#
# SSH tunneling connects to remote AIS sources through a jump host.
# Requires the `ssh` feature.
#
#   tcp = { host = "remote-server", port = 5631, jump = "jumphost.example.com" }
#   ws  = { url  = "ws://remote-server:8080/path", jump = "jumphost.example.com" }

# ========== OUTPUT SERVERS ==========
#
# Re-broadcast decoded AIS as timestamped NMEA sentences.

# TCP output: clients connect and receive NMEA stream
# serve_tcp = "0.0.0.0:5631"

# UDP output: ship162 sends NMEA to registered clients
# serve_udp = "0.0.0.0:5632"

# WebSocket output: clients connect via ws://
# serve_ws = "0.0.0.0:88888"

# Static UDP targets (always forwarded, no registration needed)
# udp_targets = ["feedme.example.org:12345"]
